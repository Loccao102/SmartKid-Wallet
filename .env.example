# Optional overrides. The dedicated SmartKid production URL and publishable key
# are already safe client-side defaults in src/lib/supabase.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Anonymous auth is enabled by default in the client. Set false only if you
# intentionally want research events to remain local until permanent login.
VITE_SUPABASE_ANONYMOUS_AUTH=true
